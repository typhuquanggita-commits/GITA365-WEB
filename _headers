# GITA 365 — tiêu đề bảo mật cho Cloudflare Pages
# Cloudflare Pages đọc tệp này ở gốc và áp cho mọi phản hồi.
# Netlify dùng đúng định dạng này. Máy chủ khác thì chuyển sang cấu hình tương ứng.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# ── VỎ ỨNG DỤNG: LUÔN HỎI LẠI MÁY CHỦ (9.99.226) ──
# Không đặt no-cache ở đây thì Cloudflare/trình duyệt giữ bản cũ, và đẩy
# bản mới lên xong mở ra vẫn thấy bản cũ — đúng lỗi "không thấy thay đổi".
# no-cache = vẫn lưu nhưng PHẢI hỏi lại (304 nếu chưa đổi, rất nhẹ), nên
# bản vá lên tới người dùng ngay lần mở kế. sw.js quan trọng nhất: nó là
# đường service worker tự cập nhật.
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/gita-app.js
  Cache-Control: no-cache
/gita-nghe.js
  Cache-Control: no-cache
/cau-hinh.js
  Cache-Control: no-cache

# Kho đã mã hoá: không bao giờ được lưu ở proxy trung gian nào
/kho/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

# Bộ khoá không bao giờ được phát hành — chặn cả khi lỡ tay đưa vào thư mục
/kho/khoa.json
  X-Robots-Tag: noindex, nofollow
